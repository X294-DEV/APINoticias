# Opcional: clave predeterminada de Express. Copia este archivo a .env.
# También puedes introducir una clave temporal desde el engranaje de la app.
NEWS_API_KEY=
# auto: noticias reales si hay clave; demostración si falta.
# live: exige una clave. demo: siempre usa ejemplos locales.
NEWS_MODE=auto
PORT=3001
